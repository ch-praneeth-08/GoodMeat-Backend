# Production Environment Variables for Render Deployment
# Copy this file and update with your actual production values

# Server Configuration
PORT=10000
NODE_ENV=production

# Session Security
SESSION_SECRET=your_secure_session_secret_here_use_strong_random_string

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/goodmeat?retryWrites=true&w=majority

# Cloudinary (Image Upload Service)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend URL (Update this to match your Vercel deployment)
# This can be your main domain or specific preview URL
FRONTEND_URL=https://good-meat-frontend-git-main-praneeths-projects-22d4c585.vercel.app

# Optional: If you have a custom domain
# FRONTEND_URL=https://www.goodmeat.com
